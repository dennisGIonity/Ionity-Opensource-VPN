<?xml version="1.0" encoding="utf-8"?>
<!-- The Gate^Flame node-agent speaks plain HTTP on the LAN (:8080), so cleartext must be
     permitted. The narrowing happens in the app, on every request: assertPrivateHost()
     refuses to send the pairing token over HTTP to anything but RFC1918, loopback,
     link-local or .local addresses. Same model as Gate^Flame's own app. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
