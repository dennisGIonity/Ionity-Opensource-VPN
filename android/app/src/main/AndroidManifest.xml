<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- allowBackup=false: nothing in this app needs restoring onto another phone. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme"
        tools:replace="android:allowBackup,android:icon,android:roundIcon,android:label,android:theme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- The engine's notification opens "<package>.activities.MainActivity": point it at ours. -->
        <activity-alias
            android:name=".activities.MainActivity"
            android:targetActivity=".MainActivity"
            android:exported="false" />

        <!-- Embedded OpenVPN engine (ics-openvpn): keep the VPN service, drop its public
             control API, boot receiver and app-restrictions, which this app does not use. -->
        <service android:name="de.blinkt.openvpn.api.ExternalOpenVPNService" tools:node="remove" />
        <activity android:name="de.blinkt.openvpn.api.GrantPermissionsActivity" tools:node="remove" />
        <activity android:name="de.blinkt.openvpn.api.ConfirmDialog" tools:node="remove" />
        <activity android:name="de.blinkt.openvpn.api.RemoteAction" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.ConnectVPN" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.DisconnectVPN" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.PauseVPN" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.ResumeVPN" tools:node="remove" />
        <receiver android:name="de.blinkt.openvpn.OnBootReceiver" tools:node="remove" />
        <meta-data android:name="android.content.APP_RESTRICTIONS" tools:node="remove" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <!-- The tunnel engine watches for network changes to reconnect. Normal permission, no prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Haptic tick on connect. Normal permission, no prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
